# Copy this file to .env for local development.
# On Railway, set these in the Variables tab — do NOT commit real values.

# PostgreSQL connection string — Railway auto-injects this when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# JWT token lifetime in minutes (480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Your Netlify frontend URL — allows CORS from your deployed frontend
# Comma-separate multiple origins if needed
ALLOWED_ORIGINS=https://your-site.netlify.app

# One-time setup secret for /auth/force-setup endpoint (change after first use)
SETUP_SECRET=change-this-to-something-secret
