DATABASE_URL=sqlite:///./pos_database.db

# Cryptographically random 64-char hex key — DO NOT share or commit this file
SECRET_KEY=7e663d0648189be4f5a5e04f15ae2b556c76a0ef849749da0df9841a9cb42eba

# JWT token lifetime in minutes (480 = 8-hour shift)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Example for live server: ALLOWED_ORIGINS=https://yourshop.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:5502,http://127.0.0.1:5502,http://localhost:3000,http://127.0.0.1:3000

# One-time setup secret — required to call GET /auth/force-setup
# Change this to something only you know, then remove the endpoint after first run
SETUP_SECRET=change-this-setup-secret-before-first-use
